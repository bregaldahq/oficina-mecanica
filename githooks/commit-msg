#!/usr/bin/env bash
#
# Convenções de commit do AGENTS.md, para qualquer pessoa ou agente: Conventional Commits com
# escopo, assunto sem acento, sem Co-Authored-By e sem rodapé de ferramenta.
# Instalado por `bin/ws hooks install` (core.hooksPath).
set -euo pipefail

msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -1)"

case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  assunto: $subject" >&2
  exit 1
}

grep -qE '^(feat|fix|chore|docs|refactor|test|ci|perf|style|build|revert)\([a-z0-9-]+\)!?: .+' <<< "$subject" \
  || fail "use Conventional Commits com escopo, ex.: fix(gateway): rota dedicada para o webhook"
if LC_ALL=C grep -q '[^ -~]' <<< "$subject"; then
  fail "o assunto vai sem acento"
fi
if grep -qiE '^co-authored-by:|generated with \[?claude' "$msg_file"; then
  fail "commits saem só com o nome do autor: sem Co-Authored-By nem rodapé de ferramenta"
fi
