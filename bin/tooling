#!/usr/bin/env bash
#
# Imagem de ferramentas (tooling/Dockerfile): PHP 8.2, Composer, Terraform, tflint, kustomize,
# actionlint e shellcheck, nas versões do CI. A máquina só precisa de Docker.
#
# Uso:
#   bin/tooling tag                imprime a tag da imagem (sem construir)
#   bin/tooling image              imprime a tag da imagem, construindo-a se faltar
#   bin/tooling build              reconstrói a imagem
#   bin/tooling run <dir> <cmd...> roda o comando na imagem, com <dir> montado em /w
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/oficina-tooling"

# A tag é o hash do Dockerfile: mudou uma versão, a imagem é outra.
tag() {
  echo "oficina-tooling:$(sha256sum "$ROOT/tooling/Dockerfile" | cut -c1-12)"
}

build() {
  echo "construindo $(tag) (só na primeira vez ou quando tooling/Dockerfile muda)..." >&2
  docker build -q -t "$(tag)" "$ROOT/tooling" >/dev/null
}

image() {
  docker image inspect "$(tag)" >/dev/null 2>&1 || build
  tag
}

run() {
  local dir img
  dir="$(cd "${1:?uso: bin/tooling run <dir> <comando...>}" && pwd -P)"; shift
  [[ $# -gt 0 ]] || { echo "uso: bin/tooling run <dir> <comando...>"; exit 1; }
  img="$(image)"
  mkdir -p "$CACHE/composer"
  local tty=()
  [[ -t 0 && -t 1 ]] && tty=(-it)
  # Sem credenciais: nem ~/.aws nem ~/.config/gh entram no container.
  # ${tty[@]+...}: array vazio com set -u quebra no bash 3.2 do macOS.
  exec docker run --rm ${tty[@]+"${tty[@]}"} -u "$(id -u):$(id -g)" \
    -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer -e COMPOSER_CACHE_DIR=/cache/composer \
    -e TF_IN_AUTOMATION=1 -e CHECKPOINT_DISABLE=1 \
    -v "$dir":/w -v "$CACHE":/cache -w /w "$img" "$@"
}

case "${1:-}" in
  tag)   tag ;;
  image) image ;;
  build) build; tag ;;
  run)   shift; run "$@" ;;
  *)
    sed -n '3,11p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
