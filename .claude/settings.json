{
  "permissions": {
    "allow": [
      "Bash(bin/ws status)",
      "Bash(bin/ws prs)",
      "Bash(bin/check-contracts.py)",
      "Bash(bin/check-contracts.py --verbose)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git -C repos/*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=* apply:*)",
      "Bash(terraform -chdir=* destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(gh workflow run:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)"
    ]
  }
}
