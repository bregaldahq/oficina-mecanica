{
  "permissions": {
    "allow": [
      "Bash(bin/ws status)",
      "Bash(bin/ws prs:*)",
      "Bash(bin/ws grep:*)",
      "Bash(bin/ws context)",
      "Bash(bin/ws ci:*)",
      "Bash(bin/ws diff:*)",
      "Bash(bin/ws verify:*)",
      "Bash(bin/ws doctor)",
      "Bash(bin/tooling tag)",
      "Bash(bin/tooling image)",
      "Bash(bin/check-contracts.py)",
      "Bash(bin/check-contracts.py --verbose)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)",
      "Bash(git -C * grep*)",
      "Bash(git -C * ls-files*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * branch --show-current)",
      "Bash(git -C * branch -a*)",
      "Bash(git -C * branch -v*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)"
    ],
    "ask": [
      "Bash(bin/ws branch:*)",
      "Bash(bin/ws isolate:*)",
      "Bash(bin/ws hooks:*)",
      "Bash(git push:*)",
      "Bash(git -C * push*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git checkout -- *)",
      "Bash(git -C * checkout -- *)",
      "Bash(git restore*)",
      "Bash(git -C * restore*)",
      "Bash(git branch -D*)",
      "Bash(git -C * branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git -C * stash drop*)",
      "Bash(git -C * stash clear*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh repo edit:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(terraform -chdir=* import*)",
      "Bash(terraform -chdir=* state*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl * apply*)",
      "Bash(kubectl * delete*)",
      "Bash(kubectl * patch*)",
      "Bash(kubectl * edit*)",
      "Bash(kubectl * scale*)",
      "Bash(kubectl * rollout*)",
      "Bash(kubectl * create*)",
      "Bash(kubectl * exec*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(helm rollback:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws ssm get-parameter* --with-decryption*)",
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(aws * modify-*)",
      "Bash(aws * terminate-*)",
      "Bash(gh workflow run:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X *)",
      "Bash(gh api * -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * --method *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main*)",
      "Bash(git push * develop*)",
      "Bash(git push *:main*)",
      "Bash(git push *:develop*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * main*)",
      "Bash(git -C * push * develop*)",
      "Bash(git -C * push *:main*)",
      "Bash(git -C * push *:develop*)",
      "Bash(cat *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(grep * *.env)",
      "Bash(docker compose config*)",
      "Bash(docker-compose config*)",
      "Bash(printenv*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/*.tfstate*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-edit.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
